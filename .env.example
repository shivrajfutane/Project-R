# AWS Cognito Configuration for Frontend (Amplify v6)
# Note: Vite environment variables must start with VITE_ to be exposed to client bundle.
# These values are public client identifiers (NEVER store AWS Secret Access Keys here).

# AWS Region where your User Pool is created (e.g., us-east-1, ap-south-1, eu-west-1)
VITE_AWS_REGION=ap-south-1

# Amazon Cognito User Pool ID (Found in Cognito Console > User Pools > General Information)
VITE_COGNITO_USER_POOL_ID=ap-south-1_xxxxxxxxx

# Amazon Cognito App Client ID (Found in User Pools > App integration > App clients)
# Ensure the App Client does NOT have a client secret generated!
VITE_COGNITO_USER_POOL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: Amazon Cognito Domain for Hosted UI / Google Federation
# Example: https://my-auth-domain.auth.ap-south-1.amazoncognito.com
VITE_COGNITO_DOMAIN=

# Optional: Redirect URLs for Google Federation / Hosted UI
VITE_REDIRECT_SIGN_IN_URL=http://localhost:3000/dashboard
VITE_REDIRECT_SIGN_OUT_URL=http://localhost:3000/
